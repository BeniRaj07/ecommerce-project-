# Copy this file to .env and fill in your keys. Never commit .env.

# ── Required API keys ─────────────────────────────────────────────
GROQ_API_KEY=            # https://console.groq.com/keys  (speech-to-text + LLM)
GEMINI_API_KEY=          # https://aistudio.google.com/apikey  (text-to-speech)
NEWS_API_KEY=            # https://newsapi.org/register
FOOTBALL_DATA_KEY=       # https://www.football-data.org/client/register
ELEVENLABS_API_KEY=      # https://elevenlabs.io/app/settings/api-keys  (voice of every reply)

# ── Optional settings (defaults shown) ────────────────────────────
# APP_TIMEZONE=Asia/Kathmandu
# HUD_CITY=Kathmandu                  # city for the weather gauge and the daily briefing
# BRIEFING_LANGUAGE=en                 # en | ne — language of the spoken briefing when the app opens
# GROQ_LLM_MODEL=openai/gpt-oss-20b
# GROQ_STT_MODEL=whisper-large-v3
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# GEMINI_VOICE=Kore

# Text-to-speech engine tried first for each language: elevenlabs | gemini | edge
# (the others are used automatically as fallbacks)
# TTS_ENGINE_EN=elevenlabs
# TTS_ENGINE_NE=elevenlabs
# ELEVENLABS_VOICE_ID=FL6uoOl4FRyQjIxYJbjj     # https://elevenlabs.io/voices/FL6uoOl4FRyQjIxYJbjj
# ELEVENLABS_MODEL_EN=eleven_multilingual_v2
# ELEVENLABS_MODEL_NE=eleven_v3               # multilingual_v2 does not support Nepali
# EDGE_VOICE_EN=en-US-JennyNeural
# EDGE_VOICE_NE=ne-NP-HemkalaNeural     # or ne-NP-SagarNeural (male)

# REMINDER_CHECK_SECONDS=20
# HTTP_TIMEOUT=15
# SERVER_HOST=127.0.0.1                 # keep 127.0.0.1 for a local, single-user app
# SERVER_PORT=7860
# APP_AUTH=username:password            # set this if you ever expose the app beyond localhost
# DB_PATH=data/assistant.db
# LOG_LEVEL=INFO
